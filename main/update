import { lib, game, ui, get, ai, _status } from "../../../noname.js";
import { createProgress } from "../../../library/update.js";

// 感谢秋礼提供的在线更新OwO
/**
 * 鸽府包更新主函数
 * @param {boolean} manual 是否手动触发
 */
export default async function update(manual = false) {
  if (_status.connectMode && manual) {
    alert("联机状态下无法更新");
    return;
  }
  if (!window.navigator.onLine && manual) {
    alert("无网络连接，无法检查更新");
    return;
  }

  // 自动检查防重复
  if (!manual && sessionStorage.wumihuaxian_check) return;
  if (!manual) sessionStorage.wumihuaxian_check = "1";

  // 镜像源
  const proxyList = [
    "",
    "https://gh-proxy.com/",
    "https://hk.gh-proxy.com/",
    "https://tvv.tw/",
  ];

  const sourceIndex = parseInt(lib.config.extension_鸽府包_update_source) || 0;
  let proxy = proxyList[sourceIndex] || proxyList[0];
  let remoteManifest = null;
  let success = false;

  // 尝试获取清单
  const tryUrls = [proxy, ...proxyList.filter(x => x !== proxy)];
  for (const p of tryUrls) {
    try {
      const url = `${p}https://raw.githubusercontent.com/QingXin-design/GFB/main/manifest.json`;
      const res = await fetch(url);
      if (res.ok) {
        remoteManifest = await res.json();
        proxy = p;
        success = true;
        break;
      }
    } catch (e) {
      console.warn(`[鸽府包更新] 镜像 ${p} 失败`, e);
    }
  }

  if (!success || !remoteManifest) {
    if (manual) alert("获取更新信息失败，请检查网络或切换镜像源");
    return;
  }

  // 对比哈希
  const needUpdate = [];
  const hex = Array.from({ length: 256 }, (_, i) => i.toString(16).padStart(2, "0"));

  for (const [filePath, remoteHash] of Object.entries(remoteManifest.files || {})) {
    const localPath = `extension/鸽府包/${filePath}`;
    try {
      const exists = await game.promises.checkFile(localPath);
      if (!exists) {
        needUpdate.push(filePath);
        continue;
      }

      const buf = await crypto.subtle.digest("SHA-1", await game.promises.readFile(localPath));
      const localHash = Array.from(new Uint8Array(buf), x => hex[x]).join("");
      if (localHash !== remoteHash) needUpdate.push(filePath);
    } catch {
      needUpdate.push(filePath);
    }
  }

  // 无更新
  if (needUpdate.length === 0) {
    if (manual) alert(`已是最新版本\n当前版本：${remoteManifest.version}`);
    return;
  }

  // 手动确认
  if (manual) {
    const confirmUpdate = confirm(
      `发现新版本：${remoteManifest.version}\n` +
      `需要更新：${needUpdate.length} 个文件\n\n` +
      `是否立即更新？`
    );
    if (!confirmUpdate) return;
  }

  // 开始更新
  const prog = createProgress("正在更新鸽府包", needUpdate.length);
  game.importedPack = true;

  try {
    for (let i = 0; i < needUpdate.length; i++) {
      const file = needUpdate[i];
      prog.setFileName(`下载：${file}`);
      prog.setProgressValue(i + 1);

      const url = `${proxy}https://raw.githubusercontent.com/QingXin-design/GFB/main/${file}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`下载失败：${file}`);

      const data = await res.arrayBuffer();
      const fullPath = `extension/鸽府包/${file}`;
      const dir = fullPath.substring(0, fullPath.lastIndexOf("/"));
      
      await game.promises.createDir(dir);
      await game.promises.writeFile(data, dir, fullPath.split("/").pop());
    }

    // 更新清单
    await game.promises.writeFile(
      JSON.stringify(remoteManifest, null, 2),
      "extension/鸽府包",
      "manifest.json"
    );

    // 清理冗余文件
    const cleanDir = async (dir, prefix = "") => {
      const [subDirs, files] = await game.promises.getFileList(dir);
      let list = files.map(f => prefix ? `${prefix}/${f}` : f);
      for (const d of subDirs) {
        list = list.concat(await cleanDir(`${dir}/${d}`, prefix ? `${prefix}/${d}` : d));
      }
      return list;
    };

    const localFiles = await cleanDir("extension/鸽府包");
    const deleteFiles = localFiles.filter(f => !remoteManifest.files[f] && f !== "manifest.json");

    if (deleteFiles.length > 0) {
      const delProg = createProgress("清理旧文件", deleteFiles.length);
      for (let i = 0; i < deleteFiles.length; i++) {
        delProg.setProgressValue(i + 1);
        await game.promises.removeFile(`extension/鸽府包/${deleteFiles[i]}`);
      }
      delProg.remove();
    }

    alert("更新完成！游戏即将重启");
    game.reload();
  } catch (err) {
    console.error("[鸽府包更新失败]", err);
    if (manual) alert(`更新失败：\n${err.message || "未知错误"}`);
  } finally {
    prog?.remove();
    delete game.importedPack;
  }
}

/**
 * 竞技场自动检查更新
 */
export async function arenaReady() {
  if (_status.connectMode) return;
  if (lib.config.extension_五花米线_auto_update) {
    try {
      await update(false);
    } catch (e) {
      console.warn("[五花米线·自动更新] 检查失败", e);
    }
  }
}
